# Copy this file to ".env" and fill it in. Never commit ".env".

# ── Email (SMTP) ─────────────────────────────────────────────
# Leave SMTP_HOST empty to test locally: passcodes are then printed in the server terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dhyanpatel.4670@gmail.com
SMTP_PASS=gryicipqcguamkev
MAIL_FROM="DP Studio <dhyanpatel.4670@gmail.com>"
SITE_NAME=DP Studio

# ── Server ───────────────────────────────────────────────────
PORT=8787
# Set to "production" when you deploy (hides dev hints).
NODE_ENV=development
# Behind a proxy/host like Render, Railway or Nginx, set to 1 so rate limits see the real visitor IP.
TRUST_PROXY=

# ── Visitor log (OFF by default) ─────────────────────────────
# true = save each verified visitor's email + time to server/data/visitors.jsonl.
# The form shows visitors a notice about this automatically. Only turn it on if you're comfortable
# with data-protection rules where your visitors live (e.g. GDPR / India's DPDP Act).
LOG_VISITORS=false
